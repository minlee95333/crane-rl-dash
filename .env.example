# 로컬 실행 옵션. 이 파일을 ".env" 로 복사해서 쓰면 됩니다.
#
#   cp .env.example .env
#
# 이 빌드는 로컬 전용입니다. 원격 데이터베이스도, 클라우드 인증도 없습니다.
# 계정·플레이 기록·IRL 산출물은 전부 이 폴더 안의 JSON 파일로 저장됩니다.
# 따라서 여기에 넣어야 할 비밀값은 하나도 없고, 아래 항목은 전부 선택입니다.
# 아무것도 설정하지 않아도 `python app.py` 로 바로 실행됩니다.

# 관리자 화면(/trainer, /hub) 접근용 임시 토큰. 로컬 부트스트랩 전용으로,
# 한 번 ?token=... 으로 넘기면 UI가 localStorage에 저장하고 주소창에서 지웁니다.
# 주석 처리해두면 루프백에서는 관리자 경로가 열려 있습니다.
# CRANE_DASHBOARD_TOKEN=local-dev-token

# 로그인한 계정 중 관리자 권한을 줄 이메일(쉼표 구분).
# CRANE_ADMIN_EMAILS=you@example.com,teammate@example.com

# API 요청 본문 최대 크기(바이트). 기본 1 MiB.
# CRANE_MAX_JSON_BODY_BYTES=1048576

# 클라이언트(IP)별 요청 제한. "횟수/초" 형식이고 루프백은 항상 면제라
# 혼자 로컬에서 쓸 때는 건드릴 일이 없습니다. 0이면 해당 항목 비활성화.
# CRANE_RATE_LIMIT_AUTH=20/60
# CRANE_RATE_LIMIT_IDENTITY=90/60
# CRANE_RATE_LIMIT_LOGIN_ID=10/60
# CRANE_RATE_LIMIT_GAME=6/60
# CRANE_RATE_LIMIT_PLAY=30/60
# CRANE_RATE_LIMIT_PLAY_IP=300/60

# 접속 토큰의 신원 캐시 유지 시간(초). 기본 60.
# CRANE_AUTH_CACHE_TTL=60

# 로그인 세션 유지 일수. 기본 30.
# CRANE_AUTH_SESSION_DAYS=30

# 아직 승인되지 않은 동의서로 연구 참여 화면을 열어 확인하고 싶을 때만 사용.
# HOST 가 루프백이고 CRANE_PUBLIC_GAME 이 꺼져 있을 때만 받아들입니다.
# CRANE_RESEARCH_ALLOW_DRAFT_CONSENT=1

# ────────────────────────────────────────────────────────────────────
# 켜지 마세요: 루프백 밖으로 여는 옵션들.
#
# 이 빌드는 접근 제어가 있는 데이터베이스 없이 참여자 이메일·이름을 평문
# JSON 으로 로컬 디스크에 씁니다. 개인 컴퓨터에서 혼자 쓰는 전제라 괜찮은
# 것이고, 외부에 열면 그 전제가 깨집니다.
#
#   CRANE_PUBLIC_GAME=1     인증 없이 게임 API 개방
#   HOST=0.0.0.0            모든 네트워크 인터페이스에 바인드
#   CRANE_TRUST_PROXY=1     리버스 프록시 뒤에서만 의미 있음
#
# 공개 수집이 필요하면 서버 사이드 DB 를 갖춘 배포 버전을 따로 쓰세요.
